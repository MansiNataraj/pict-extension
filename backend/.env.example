# Copy this file to .env and fill in your own values:  cp .env.example .env
# Never commit .env (it is already in .gitignore).

# Gemini API key (get one at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional overrides (defaults shown)
# CLOUD_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models
# CLOUD_MODEL_NAME=gemini-3.5-flash-lite
# CLOUD_TIMEOUT_SECONDS=10.0

# Optional local fallback via Ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1
# LOCAL_MODEL_NAME=aya-expanse:8b
